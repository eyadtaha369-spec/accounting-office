# رابط الـ Web app من Apps Script (Deploy → Web app URL)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# يظهر في Execution log بعد تشغيل setup() في Apps Script — سري
APPS_SCRIPT_SECRET=

# مفتاح توقيع جلسات الدخول — أنشئه بـ: npm run gen:key
SESSION_SECRET=

# مفتاح تشفير بيانات دخول البوابات الضريبية — أنشئه بـ: npm run gen:key (مفتاح مختلف)
CREDENTIALS_ENCRYPTION_KEY=
